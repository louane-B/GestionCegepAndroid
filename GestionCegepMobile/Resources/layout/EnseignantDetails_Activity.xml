<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEFF1"
	android:id="@+id/scrollView">

	<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
		android:layout_marginTop="100dp">

		<!-- TITRE -->

		<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Informations de l'enseignant"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="20dp" />

		<!-- CARTE INFO -->

		<LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp">

			<!-- NO -->

			<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

				<TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="No :"
                    android:textStyle="bold"
                    android:textColor="#37474F" />

				<TextView
                    android:id="@+id/lblNoEnseignantAfficher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="#546E7A" />
			</LinearLayout>

			<!-- NOM -->

			<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

				<TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Nom :"
                    android:textStyle="bold"
                    android:textColor="#37474F" />

				<TextView
                    android:id="@+id/lblNomEnseignantAfficher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="#546E7A" />
			</LinearLayout>

			<!-- PRENOM -->

			<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

				<TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Prénom :"
                    android:textStyle="bold"
                    android:textColor="#37474F" />

				<TextView
                    android:id="@+id/lblPrenomEnseignantAfficher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="#546E7A" />
			</LinearLayout>

			<!-- ADRESSE -->

			<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

				<TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Adresse :"
                    android:textStyle="bold"
                    android:textColor="#37474F" />

				<TextView
                    android:id="@+id/lblAdresseEnseignantAfficher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="#546E7A" />
			</LinearLayout>

			<!-- VILLE -->

			<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

				<TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Ville :"
                    android:textStyle="bold"
                    android:textColor="#37474F" />

				<TextView
                    android:id="@+id/lblVilleEnseignantAfficher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="#546E7A" />
			</LinearLayout>

			<!-- PROVINCE -->

			<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

				<TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Province :"
                    android:textStyle="bold"
                    android:textColor="#37474F" />

				<TextView
                    android:id="@+id/lblProvinceEnseignantAfficher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="#546E7A" />
			</LinearLayout>

			<!-- CODE POSTAL -->

			<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

				<TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Code postal :"
                    android:textStyle="bold"
                    android:textColor="#37474F" />

				<TextView
                    android:id="@+id/lblCodePostalEnseignantAfficher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="#546E7A" />
			</LinearLayout>

			<!-- TELEPHONE -->

			<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

				<TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Téléphone :"
                    android:textStyle="bold"
                    android:textColor="#37474F" />

				<TextView
                    android:id="@+id/lblTelephoneEnseignantAfficher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="#546E7A" />
			</LinearLayout>

			<!-- COURRIEL -->

			<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

				<TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Courriel :"
                    android:textStyle="bold"
                    android:textColor="#37474F" />

				<TextView
                    android:id="@+id/lblCourrielEnseignantAfficher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="#546E7A" />
			</LinearLayout>

		</LinearLayout>

	</LinearLayout>

</ScrollView>