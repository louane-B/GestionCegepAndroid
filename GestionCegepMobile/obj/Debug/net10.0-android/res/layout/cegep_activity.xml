<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:background="#ECEFF1" android:id="@+id/scrollView" xmlns:android="http://schemas.android.com/apk/res/android"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="100dp"><!-- TITRE --><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gestion des Cégeps" android:textSize="28sp" android:textStyle="bold" android:textColor="#1565C0" android:layout_marginBottom="20dp" /><!-- LISTE DES CÉGEPS --><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#FFFFFF" android:padding="16dp" android:layout_marginBottom="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Liste des cégeps" android:textSize="20sp" android:textStyle="bold" android:textColor="#263238" android:layout_marginBottom="12dp" /><ListView android:id="@+id/listViewCegep" android:layout_width="match_parent" android:layout_height="200dp" android:divider="#CFD8DC" android:dividerHeight="1dp" /></LinearLayout><!-- FORMULAIRE --><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#FFFFFF" android:padding="16dp" android:layout_marginBottom="150dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ajouter un cégep" android:textSize="20sp" android:textStyle="bold" android:textColor="#263238" android:layout_marginBottom="12dp" /><!-- NOM --><EditText android:id="@+id/edtNomInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nom" android:padding="12dp" android:background="#F5F5F5" android:layout_marginBottom="12dp" /><!-- ADRESSE --><EditText android:id="@+id/edtAdresseInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Adresse" android:padding="12dp" android:background="#F5F5F5" android:layout_marginBottom="12dp" /><!-- VILLE --><EditText android:id="@+id/edtVilleInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ville" android:padding="12dp" android:background="#F5F5F5" android:layout_marginBottom="12dp" /><!-- PROVINCE --><EditText android:id="@+id/edtProvinceInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Province" android:padding="12dp" android:background="#F5F5F5" android:layout_marginBottom="12dp" /><!-- CODE POSTAL --><EditText android:id="@+id/edtCodePostalInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Code postal" android:padding="12dp" android:background="#F5F5F5" android:layout_marginBottom="12dp" /><!-- TÉLÉPHONE --><EditText android:id="@+id/edtTelephoneInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Téléphone" android:inputType="phone" android:padding="12dp" android:background="#F5F5F5" android:layout_marginBottom="12dp" /><!-- COURRIEL --><EditText android:id="@+id/edtCourrielInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Courriel" android:inputType="textEmailAddress" android:padding="12dp" android:background="#F5F5F5" android:layout_marginBottom="20dp" /><!-- BOUTON --><Button android:id="@+id/btnAjouter" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AJOUTER" android:textStyle="bold" android:textColor="#FFFFFF" android:background="#198754" android:padding="14dp" /></LinearLayout></LinearLayout></ScrollView>